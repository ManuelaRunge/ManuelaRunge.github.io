---
import { site, social } from "@/site.config";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__brand">
      <img src={site.turtleMark} alt="" class="footer__mark" aria-hidden="true" />
      <p class="footer__name">{site.name}</p>
      <p class="footer__tagline">{site.tagline}</p>
    </div>
    <div class="footer__links">
      <a href={social.googlescholar}>Google Scholar</a>
      <a href={social.orcid}>ORCID</a>
      <a href={social.linkedin}>LinkedIn</a>
      <a href={social.github}>GitHub</a>
      <a href={`mailto:${site.email}`}>Email</a>
    </div>
    <p class="footer__disclosure">
      This website was developed with AI-assisted drafting, editing, design, and
      coding support. All factual content, professional positioning, and final
      editorial decisions were reviewed and approved by Manuela Runge.
    </p>
    <p class="footer__copy">&copy; {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    padding: 3rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--charcoal);
    color: #fff;
  }

  .footer__inner {
    display: grid;
    gap: 1.5rem;
  }

  .footer__mark {
    width: 3.6rem;
    margin-bottom: 0.9rem;
    opacity: 0.42;
    filter: brightness(0) invert(1);
  }

  .footer__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .footer__tagline {
    margin: 0.25rem 0 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer__links a {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .footer__links a:hover {
    color: #79c9ce;
  }

  .footer__copy {
    margin: 0;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.58);
  }

  .footer__disclosure {
    max-width: 68ch;
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.58);
  }
</style>
