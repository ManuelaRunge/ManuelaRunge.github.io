---
import { countries } from "@/site.config";
---

<section class="countries" aria-label="International experience">
  <div class="countries__inner">
    <p class="countries__label">International experience</p>
    <div class="countries__list">
      {
        countries.map((c) => (
          <span class="countries__item" title={c.name}>
            <span class="countries__code">{c.code}</span>
            <span class="countries__name">{c.name}</span>
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .countries {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .countries__inner {
    display: grid;
    gap: 0.9rem;
  }

  .countries__label {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .countries__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .countries__item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .countries__code {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent);
  }

  .countries__name {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
