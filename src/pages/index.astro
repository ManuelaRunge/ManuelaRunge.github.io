---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import ExpertiseGrid from "@/components/ExpertiseGrid.astro";
import ContentCard from "@/components/ContentCard.astro";
import { getCollection } from "astro:content";
import ProfessionalRecordNote from "@/components/ProfessionalRecordNote.astro";

const writing = (await getCollection("posts")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const publications = (await getCollection("publications"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const talks = (await getCollection("talks"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projects = await getCollection("portfolio");

const selectedPublications = publications.slice(0, 6);
const selectedProjects = projects;
const selectedTalks = talks.slice(0, 6);
const selectedWork = [
  ...selectedPublications.map((pub) => ({
    title: pub.data.title,
    meta: `Paper · ${pub.data.venue ?? "Publication"} · ${pub.data.date.getFullYear()}`,
    date: pub.data.date,
    href: pub.data.paperurl ?? `/publications/#${pub.id}`,
    external: !!pub.data.paperurl,
  })),
  ...selectedTalks.map((talk) => ({
    title: talk.data.title,
    meta: `${talk.data.type ?? "Talk"} · ${talk.data.venue ?? "Presentation"} · ${talk.data.date.getFullYear()}`,
    date: talk.data.date,
    href: `/talks/#${talk.id}`,
    external: false,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const cleanSnippet = (value = "", length = 180) =>
  value
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, length);

const trajectoryItems = [
  ...selectedProjects.map((project) => ({
    title: project.data.title,
    meta: project.data.label ?? "Case study",
    description: cleanSnippet(
      project.data.excerpt ||
        (typeof project.body === "string" ? project.body : ""),
      190,
    ),
    href: project.data.externalUrl ?? `/portfolio/#${project.id}`,
    external: !!project.data.externalUrl,
  })),
];
---

<BaseLayout>
  <div class="home-redesign">
  <Hero />
  <ExpertiseGrid />
  <section class="section purpose" aria-labelledby="purpose-heading">
    <div class="container purpose__grid">
      <div><p class="section-label">What drives my work</p><h2 id="purpose-heading">Good questions.<br />Shared understanding.</h2></div>
      <div class="purpose__copy">
        <p>Many diseases and adverse health outcomes are preventable, treatable or reducible. Understanding where and how research can inform action is what keeps me asking questions.</p>
        <p>I value scientific curiosity, continuous learning and the exchange of ideas. Writing is one way I make sense of complex research and share useful knowledge with others.</p>
        <a href="/collaboration/">Exchange ideas or discuss a collaboration &rarr;</a>
      </div>
    </div>
  </section>
  <section class="section selected-writing" aria-labelledby="writing-heading">
    <div class="container">
      <div class="section-heading">
        <div><p class="section-label">Ideas &amp; observations</p><h2 id="writing-heading" class="section-title">Selected Writing</h2></div>
        <a href="/blog/" class="text-link">All writing &rarr;</a>
      </div>
      <div class="writing-grid">
        {writing.map((post, index) => (
          <article class="writing-card">
            <div class="writing-card__top"><span>Event report</span><span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span></div>
            <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString("en-GB", { month: "long", year: "numeric", timeZone: "UTC" })}</time>
            <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
            {post.data.excerpt && <p>{post.data.excerpt}</p>}
            <span class="writing-card__arrow" aria-hidden="true">&nearr;</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="selected-work">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-label">Selected work</p>
          <h2 class="section-title">Papers, talks and posters</h2>
        </div>
        <div class="section-actions">
          <a href="/publications/" class="btn">All publications</a>
          <a href="/talks/" class="btn">All talks & posters</a>
          <div class="carousel-controls" aria-label="Selected work carousel controls">
            <button class="carousel-btn" type="button" data-carousel-prev aria-label="Previous item">‹</button>
            <button class="carousel-btn" type="button" data-carousel-next aria-label="Next item">›</button>
          </div>
        </div>
      </div>
      <ProfessionalRecordNote />
      <div class="carousel carousel--work" data-carousel>
        <div class="carousel__track" data-carousel-track tabindex="0" aria-label="Selected papers, talks and posters">
        {
          selectedWork.map((item) => (
            <ContentCard
              title={item.title}
              meta={item.meta}
              href={item.href}
              external={item.external}
            />
          ))
        }
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand" id="portfolio">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-label">Research trajectory</p>
          <h2 class="section-title">Selected projects and fields of work</h2>
        </div>
        <div class="section-actions">
          <a href="/portfolio/" class="btn">View portfolio</a>
          <div class="carousel-controls" aria-label="Carousel controls">
            <button class="carousel-btn" type="button" data-carousel-prev aria-label="Previous item">‹</button>
            <button class="carousel-btn" type="button" data-carousel-next aria-label="Next item">›</button>
          </div>
        </div>
      </div>
      <div class="carousel" data-carousel>
        <div class="carousel__track" data-carousel-track tabindex="0" aria-label="Selected projects, network roles and fields of work">
        {
          trajectoryItems.map((item) => (
            <ContentCard
              title={item.title}
              meta={item.meta}
              description={item.description}
              href={item.href}
              external={item.external}
            />
          ))
        }
        </div>
      </div>
    </div>
  </section>


  </div>
</BaseLayout>

<style>
  .home-redesign { --accent: #315b4e; --accent-hover: #214236; --accent-soft: #e5ebe2; }
  .home-redesign :global(:focus-visible) { outline: 3px solid #83692f; outline-offset: 5px; }
  .purpose { background: #eeeee4; }
  .purpose__grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 4rem; align-items: start; }
  .purpose h2 { margin: 0; font-size: clamp(2rem, 3.5vw, 3rem); color: #254d43; }
  .purpose__copy p { margin: 0 0 1.2rem; max-width: 60ch; color: var(--text-muted); }
  .purpose__copy a, .text-link { text-decoration: underline; text-underline-offset: 5px; }
  .selected-writing { background: var(--bg-elevated); border-bottom: 1px solid var(--border); }
  .writing-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .writing-card { position: relative; padding: 1.8rem; border: 1px solid var(--border); background: #f7f4ec; display: flex; flex-direction: column; align-items: start; }
  .writing-card__top { display: flex; width: 100%; justify-content: space-between; gap: 1rem; border-bottom: 1px solid #b4a16d; padding-bottom: 2rem; margin-bottom: 1.6rem; color: #6f5d32; font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .writing-card time { font-size: 0.8rem; color: var(--text-muted); }
  .writing-card h3 { font-size: 1.5rem; line-height: 1.3; margin: 0.8rem 0 1.6rem; }
  .writing-card h3 a { color: #254d43; }
  .writing-card h3 a::after { content: ""; position: absolute; inset: 0; }
  .writing-card:focus-within { outline: 3px solid #83692f; outline-offset: 4px; }
  .writing-card:hover h3 a { text-decoration: underline; text-underline-offset: 4px; }
  .writing-card__arrow { margin-top: auto; color: #315b4e; font-size: 1.4rem; }
  @media (max-width: 760px) { .purpose__grid, .writing-grid { grid-template-columns: 1fr; gap: 1.5rem; } }

  #methods,
  #selected-work,
  #portfolio {
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.4rem;
  }

  .section-heading .section-title {
    margin-bottom: 0;
  }

  .section-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .carousel {
    position: relative;
  }

  .carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, 31%);
    gap: 1.4rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding: 0.25rem;
    padding: 0.25rem 0 1rem;
    scrollbar-width: thin;
  }

  .carousel__track :global(.card) {
    min-height: 21rem;
    scroll-snap-align: start;
  }

  .carousel--work :global(.card) {
    min-height: 0;
  }

  .carousel-controls {
    display: inline-flex;
    gap: 0.4rem;
  }

  .carousel-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(40, 127, 131, 0.28);
    border-radius: 8px;
    background: var(--bg-elevated);
    color: var(--accent);
    font-size: 1.45rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .carousel-btn:hover {
    transform: translateY(-1px);
    border-color: rgba(40, 127, 131, 0.5);
    color: var(--accent-hover);
  }

  @media (max-width: 860px) {
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .section-actions {
      width: 100%;
      justify-content: space-between;
    }

    .carousel__track {
      grid-auto-columns: minmax(260px, 86%);
    }


  }
</style>

<script>
  document.querySelectorAll("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector("[data-carousel-track]");
    const section = carousel.closest("section");
    const prev = section?.querySelector("[data-carousel-prev]");
    const next = section?.querySelector("[data-carousel-next]");

    const scrollByCard = (direction) => {
      if (!(track instanceof HTMLElement)) return;
      const firstCard = track.querySelector(".card");
      const amount =
        firstCard instanceof HTMLElement
          ? firstCard.getBoundingClientRect().width + 24
          : track.clientWidth * 0.85;
      track.scrollBy({ left: direction * amount, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    };

    prev?.addEventListener("click", () => scrollByCard(-1));
    next?.addEventListener("click", () => scrollByCard(1));
  });
</script>
