---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import ExpertiseGrid from "@/components/ExpertiseGrid.astro";
import ContentCard from "@/components/ContentCard.astro";
import { getCollection } from "astro:content";
import ProfessionalRecordNote from "@/components/ProfessionalRecordNote.astro";

const publications = (await getCollection("publications"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const talks = (await getCollection("talks"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projects = await getCollection("portfolio");

const selectedPublications = publications.slice(0, 6);
const selectedProjects = projects;
const selectedTalks = talks.slice(0, 6);
const selectedWork = [
  ...selectedPublications.map((pub) => ({
    title: pub.data.title,
    meta: `Paper · ${pub.data.venue ?? "Publication"} · ${pub.data.date.getFullYear()}`,
    date: pub.data.date,
    href: pub.data.paperurl ?? `/publications/#${pub.id}`,
    external: !!pub.data.paperurl,
  })),
  ...selectedTalks.map((talk) => ({
    title: talk.data.title,
    meta: `${talk.data.type ?? "Talk"} · ${talk.data.venue ?? "Presentation"} · ${talk.data.date.getFullYear()}`,
    date: talk.data.date,
    href: `/talks/#${talk.id}`,
    external: false,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const cleanSnippet = (value = "", length = 180) =>
  value
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, length);

const trajectoryItems = [
  ...selectedProjects.map((project) => ({
    title: project.data.title,
    meta: project.data.label ?? "Case study",
    description: cleanSnippet(
      project.data.excerpt ||
        (typeof project.body === "string" ? project.body : ""),
      190,
    ),
    href: project.data.externalUrl ?? `/portfolio/#${project.id}`,
    external: !!project.data.externalUrl,
  })),
];
---

<BaseLayout>
  <Hero />
  <ExpertiseGrid />

  <section class="section" id="selected-work">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-label">Selected work</p>
          <h2 class="section-title">Papers, talks and posters</h2>
        </div>
        <div class="section-actions">
          <a href="/publications/" class="btn">All publications</a>
          <a href="/talks/" class="btn">All talks & posters</a>
          <div class="carousel-controls" aria-label="Selected work carousel controls">
            <button class="carousel-btn" type="button" data-carousel-prev aria-label="Previous item">‹</button>
            <button class="carousel-btn" type="button" data-carousel-next aria-label="Next item">›</button>
          </div>
        </div>
      </div>
      <ProfessionalRecordNote />
      <div class="carousel carousel--work" data-carousel>
        <div class="carousel__track" data-carousel-track tabindex="0" aria-label="Selected papers, talks and posters">
        {
          selectedWork.map((item) => (
            <ContentCard
              title={item.title}
              meta={item.meta}
              href={item.href}
              external={item.external}
            />
          ))
        }
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand" id="portfolio">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-label">Research trajectory</p>
          <h2 class="section-title">Selected projects and fields of work</h2>
        </div>
        <div class="section-actions">
          <a href="/portfolio/" class="btn">View portfolio</a>
          <div class="carousel-controls" aria-label="Carousel controls">
            <button class="carousel-btn" type="button" data-carousel-prev aria-label="Previous item">‹</button>
            <button class="carousel-btn" type="button" data-carousel-next aria-label="Next item">›</button>
          </div>
        </div>
      </div>
      <div class="carousel" data-carousel>
        <div class="carousel__track" data-carousel-track tabindex="0" aria-label="Selected projects, network roles and fields of work">
        {
          trajectoryItems.map((item) => (
            <ContentCard
              title={item.title}
              meta={item.meta}
              description={item.description}
              href={item.href}
              external={item.external}
            />
          ))
        }
        </div>
      </div>
    </div>
  </section>


</BaseLayout>

<style>
  #methods,
  #selected-work,
  #portfolio {
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.4rem;
  }

  .section-heading .section-title {
    margin-bottom: 0;
  }

  .section-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .carousel {
    position: relative;
  }

  .carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, 31%);
    gap: 1.4rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding: 0.25rem;
    padding: 0.25rem 0 1rem;
    scrollbar-width: thin;
  }

  .carousel__track :global(.card) {
    min-height: 21rem;
    scroll-snap-align: start;
  }

  .carousel--work :global(.card) {
    min-height: 0;
  }

  .carousel-controls {
    display: inline-flex;
    gap: 0.4rem;
  }

  .carousel-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(40, 127, 131, 0.28);
    border-radius: 8px;
    background: var(--bg-elevated);
    color: var(--accent);
    font-size: 1.45rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .carousel-btn:hover {
    transform: translateY(-1px);
    border-color: rgba(40, 127, 131, 0.5);
    color: var(--accent-hover);
  }

  @media (max-width: 860px) {
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .section-actions {
      width: 100%;
      justify-content: space-between;
    }

    .carousel__track {
      grid-auto-columns: minmax(260px, 86%);
    }


  }
</style>

<script>
  document.querySelectorAll("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector("[data-carousel-track]");
    const section = carousel.closest("section");
    const prev = section?.querySelector("[data-carousel-prev]");
    const next = section?.querySelector("[data-carousel-next]");

    const scrollByCard = (direction) => {
      if (!(track instanceof HTMLElement)) return;
      const firstCard = track.querySelector(".card");
      const amount =
        firstCard instanceof HTMLElement
          ? firstCard.getBoundingClientRect().width + 24
          : track.clientWidth * 0.85;
      track.scrollBy({ left: direction * amount, behavior: "smooth" });
    };

    prev?.addEventListener("click", () => scrollByCard(-1));
    next?.addEventListener("click", () => scrollByCard(1));
  });
</script>
