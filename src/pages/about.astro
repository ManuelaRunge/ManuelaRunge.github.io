---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CountriesStrip from "@/components/CountriesStrip.astro";
import { site, social } from "@/site.config";
---

<BaseLayout title="About" description="About Manuela Runge — infectious disease epidemiologist.">
  <div class="about-page">
  <section class="about-hero" aria-labelledby="about-heading">
    <div class="container about-hero__grid">
      <div>
        <p class="section-label">About me</p>
        <h1 id="about-heading">{site.title}</h1>
        <p class="about-role">Infectious disease epidemiologist &amp; mathematical modeller</p>
        <p class="about-lead">Working at the intersection of research, quantitative analysis and global health, with a focus on careful methods and shared understanding.</p>
        <CountriesStrip />
      </div>
      <figure class="about-portrait"><img src={site.profileImage} alt="Manuela Runge" width="400" height="400" fetchpriority="high" /></figure>
    </div>
  </section>
  <section class="section">
    <div class="container about">
      <div class="about__intro prose">
        <p class="section-label">Research &amp; experience</p>
        <h2 class="bio-heading">From evidence to understanding</h2>
        <p>
          I am Manuela Runge, an infectious disease epidemiologist focused on using
          epidemiological evidence, quantitative methods and scientific writing to
          understand infectious disease questions.
        </p>
        <p>
          I apply a broad range of analytical tools, from statistical analysis that
          identifies factors influencing health and disease outcomes to simulation
          modelling that projects the potential impact of interventions in populations.
          Across methods, I care about transparent assumptions, careful quality
          assurance and the limits of what data can support.
        </p>
        <p>
          Much of my experience is in malaria research in Sub-Saharan Africa. I have also
          contributed to projects on neglected tropical diseases, including onchocerciasis
          and lymphatic filariasis, as well as COVID-19, West Nile virus, and measles.
        </p>
      </div>

      <section class="about-personal" aria-labelledby="personal-heading">
        <p class="section-label">Beyond the analysis</p>
        <h2 id="personal-heading">Always learning, often writing.</h2>
        <p>I enjoy following a question beyond the immediate task, learning new methods and exchanging ideas with people who approach a problem differently. Scientific curiosity is part of how I work.</p>
        <p>Sharing knowledge helps me reflect on what I have learned and make it useful to others, whether through scientific writing, conference reports or a conversation.</p>
        <a href="/blog/">Read my articles and event reports &rarr;</a>
      </section>
      <div class="about__details">
        <div class="about__card">
          <h3>Research identity</h3>
          <ul>
            <li>Infectious disease epidemiology and public health research</li>
            <li>Malaria modelling and subnational intervention planning</li>
            <li>Evidence review, synthesis and scientific communication</li>
            <li>Ongoing collaborations across global health research networks</li>
          </ul>
        </div>

        <div class="about__card">
          <h3>Education</h3>
          <ul>
            <li>Ph.D. & M.Sc. in Epidemiology — Swiss TPH & University of Basel</li>
            <li>B.Sc. in Health Sciences — University of Applied Sciences Hamburg</li>
          </ul>
        </div>

        <div class="about__card">
          <p class="section-label">Professional contact</p>
          <h3>{site.title}</h3>
          <p class="contact-role">{site.tagline}<br />{site.location}</p>
          <ul class="about__links">
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><a href={social.googlescholar}>Google Scholar</a></li>
            <li><a href={social.orcid}>ORCID</a></li>
            <li><a href={social.linkedin}>LinkedIn</a></li>
            <li><a href={social.researchgate}>ResearchGate</a></li>
          </ul>
        </div>
      </div>

      <div class="about__actions">
        <a href="/resume_ManuelaRunge.docx" class="btn btn--primary" download>Download resume</a>
        <a href="/CV_ManuelaRunge.pdf" class="btn">View CV (PDF)</a>
        <a href="/collaboration/" class="btn">Collaborate</a>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>

<style>
  .about-page { --accent: #315b4e; --accent-hover: #214236; }
  .about-page :global(:focus-visible) { outline: 3px solid #83692f; outline-offset: 5px; }
  .about-hero { padding: calc(var(--header-height) + 4rem) 0 4rem; background: radial-gradient(ellipse at 95% 70%, #dce3d5, transparent 55%), #f7f4ec; border-bottom: 1px solid var(--border); }
  .about-hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 5rem; align-items: center; }
  .about-hero h1 { margin: 0.8rem 0 1.3rem; font-size: clamp(2.6rem, 5vw, 4.3rem); color: #254d43; }
  .about-role { max-width: 38ch; font-size: 1.2rem; color: #315b4e; }
  .about-lead { max-width: 55ch; color: var(--text-muted); margin-bottom: 2rem; }
  .about-portrait { margin: 0; padding: 0.65rem; background: #fffdf8; border: 1px solid var(--border); border-radius: 48% 48% 4px 4px; }
  .about-portrait img { border-radius: 48% 48% 2px 2px; width: 100%; aspect-ratio: 1; object-fit: cover; }
  .bio-heading { margin: 0 0 1.5rem !important; font-size: clamp(1.8rem, 3vw, 2.5rem) !important; }
  .about__intro { max-width: 75ch; }
  .about-personal { padding: 2.25rem; background: #eeeee4; border-left: 2px solid #b4a16d; }
  .about-personal h2 { margin: 0 0 1.2rem; font-size: 2rem; }
  .about-personal p:not(.section-label) { max-width: 70ch; color: var(--text-muted); }
  .about-personal a, .about__links a { text-decoration: underline; text-underline-offset: 4px; }
  .about__links a { overflow-wrap: anywhere; }
  .contact-role { color: var(--text-muted); font-size: 0.88rem; }
  @media (max-width: 760px) { .about-hero__grid { grid-template-columns: 1fr; gap: 2rem; } .about-portrait { width: min(280px, 100%); } .about-hero { padding-top: calc(var(--header-height) + 2.5rem); } .about-personal { padding: 1.5rem; } }

  .about {
    display: grid;
    gap: 3rem;
  }

  .about__intro {
    font-size: 1.08rem;
  }

  .about__details {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem;
  }

  .about__card {
    padding: 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 12px 35px rgba(24, 46, 56, 0.07);
  }

  .about__card h3 {
    margin: 0 0 1rem;
    font-size: 1.08rem;
    color: var(--accent);
  }

  .about__card ul {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--text-muted);
  }

  .about__card li {
    margin-bottom: 0.5rem;
  }

  .about__links {
    list-style: none;
    padding: 0 !important;
  }

  .about__links li {
    margin-bottom: 0.35rem;
  }

  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
