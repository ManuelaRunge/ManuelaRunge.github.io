---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProfessionalRecordNote from "@/components/ProfessionalRecordNote.astro";
import { site } from "@/site.config";

const services = [
  {
    title: "Scientific & technical review",
    description: "Manuscript assessments, statistical-methods reviews and technical reports, with clear, prioritised recommendations.",
  },
  {
    title: "Analysis & reproducible workflows",
    description: "Statistical analysis, R/Python code review, testing and debugging, visualisation and quality assurance.",
  },
  {
    title: "Evidence synthesis",
    description: "Targeted literature searches, critical appraisal and concise evidence tables. Full systematic reviews are scoped separately.",
  },
  {
    title: "Scientific writing & copyediting",
    description: "Support with scientific argument, methodological clarity, interpretation and responses to reviewers. Copyediting for grammar, clarity, style and consistency.",
  },
  {
    title: "Modelling & methodological advice",
    description: "Infectious disease model review, scenario assessment and focused technical consultations. New model development is scoped separately.",
  },
];
---

<BaseLayout title="Manuela Runge GmbH" description="Scientific and technical consultancy through Manuela Runge GmbH. Services and contact.">
  <div class="page-header">
    <div class="container">
      <h1>Manuela Runge GmbH</h1>
      <p>Scientific and technical consultancy.</p>
    </div>
  </div>
  <section class="section" aria-label="Consultancy services">
    <div class="container company-content">
      <div class="company-intro prose">
        <p>
          I founded Manuela Runge GmbH in 2022 after returning from Chicago, USA to
          Zurich, Switzerland, enabling me to continue my postdoctoral work as a scientific
          research collaborator. Through the company, I later began my first
          project with MMGH.
        </p>
        <p>
          I have kept the company active to remain open to individual projects,
          freelance assignments and independent consultancy.
        </p>
      </div>
      <div class="service-list">
        {services.map(({ title, description }) => (
          <article>
            <h2>{title}</h2>
            <p>{description}</p>
          </article>
        ))}
      </div>
      <div class="company-contact" id="contact">
        <h2>Contact</h2>
        <p>For consultancy enquiries, please send a brief description of your project and timeline.</p>
        <a class="btn btn--primary" href={`mailto:${site.email}`}>{site.email}</a>
        <p>Manuela Runge GmbH · 8404 Winterthur, Switzerland<br />UID: CHE-434.219.142 · <a href="/legal/">Legal notice</a></p>
      </div>
      <ProfessionalRecordNote />
    </div>
  </section>
</BaseLayout>

<style>
  .page-header h1 { max-width: 20ch; }
  .company-content { max-width: 850px; }
  .company-intro { margin-bottom: 3rem; }
  .company-intro p:first-child { margin-top: 0; }
  .service-list article { padding: 1.5rem 0; border-bottom: 1px solid var(--border); }
  .service-list article:first-child { padding-top: 0; }
  h2 { margin: 0 0 0.75rem; font-size: 1.35rem; }
  .service-list p, .company-contact p { color: var(--text-muted); }
  .service-list p { margin: 0; }
  .company-contact { margin: 3rem 0; }
  .company-contact .btn { overflow-wrap: anywhere; max-width: 100%; }
</style>
