---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site, social } from "@/site.config";
---

<BaseLayout title="Contact" description="Contact Manuela Runge and find her professional profiles.">
  <div class="page-header">
    <div class="container">
      <h1>Contact</h1>
      <p>For professional connections and scientific exchange.</p>
    </div>
  </div>
  <section class="section">
    <div class="container contact">
      <a class="btn btn--primary contact__email" href={`mailto:${site.email}`}>{site.email}</a>
      <nav class="contact__links" aria-label="Professional profiles">
        <a href={social.linkedin}>LinkedIn</a>
        <a href={social.googlescholar}>Google Scholar</a>
        <a href={social.orcid}>ORCID</a>
      </nav>
      <p>For consultancy services and enquiries, visit <a href="/gmbh/">Manuela Runge GmbH</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; justify-items: start; gap: 1.5rem; }
  .contact__email { max-width: 100%; overflow-wrap: anywhere; }
  .contact__links { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; }
  .contact p { margin: 0; color: var(--text-muted); }
</style>
